<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/text_volunteer_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Volunteer Name"
        android:textAppearance="?attr/textAppearanceBodyLarge"/>

    <TextView
        android:id="@+id/text_volunteer_email"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="volunteer@email.com"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"/>

    <TextView
        android:id="@+id/text_volunteer_phone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Phone: 123-456-7890"
        android:visibility="gone" android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"/>

</LinearLayout>